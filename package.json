{
  "name": "dsh-purge",
  "version": "2.0.0",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；装上就带「清洗 / 演练台 / 破甲」三页签，提示词注入层 + 拦截反射压进 system prompt，面板随时复算分数。DSH 0.2.0-rc.2 实测可用。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "postinstall": "node scripts/ensure-profile-bundle.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent",
    "笙歌",
    "shengge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shengge395/dsh-purge.git"
  },
  "homepage": "https://github.com/shengge395/dsh-purge#readme",
  "bugs": {
    "url": "https://github.com/shengge395/dsh-purge/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "zip",
      "zip": "https://github.com/shengge395/dsh-purge/archive/refs/heads/main.zip",
      "tarball": "https://github.com/shengge395/dsh-purge/archive/refs/heads/main.tar.gz",
      "source": "https://github.com/shengge395/dsh-purge"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2",
  "dshTargets": [
    "0.2.1-rc.2",
    "0.2.0-rc.2"
  ],
  "author": "笙歌",
  "contributors": [
    "小杨 (original dsh-purge)",
    "巴里啊啊 (0.2.1-rc.2 compatibility fork)"
  ]
}
